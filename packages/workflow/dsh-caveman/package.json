{
  "name": "@lornatang/dsh-caveman",
  "version": "0.1.10",
  "description": "Caveman integration for DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Lornatang",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "caveman",
    "skills"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": "*"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-caveman": "./scripts/caveman-cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cavecrew": {
      "types": "./lib/types/cavecrew.d.ts",
      "default": "./lib/cavecrew.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/caveman-cli.mjs",
    "scripts/learn-binary.mjs",
    "scripts/learn-checksums.json",
    "scripts/benchmark.mjs",
    "examples",
    "presets",
    "vendor/caveman/skills",
    "vendor/caveman/agents/cavecrew-*.md",
    "vendor/caveman/src/hooks/caveman-config.js",
    "vendor/caveman/src/hooks/caveman-parse.js",
    "vendor/caveman/src/hooks/package.json",
    "vendor/caveman/LICENSE",
    "vendor/caveman/LICENSE-MIT",
    "vendor/caveman/NOTICE",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:dsh": "node scripts/verify-dsh.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "prepack": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/cavecrew.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@caveman-ai/cli": "4.1.0",
    "@caveman-ai/sdk": "1.2.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "undici": "^8.12.4",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "undici": "$undici",
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-group": "1.1.0",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-loop": "*",
    "@deepseek-ai/dsh-agent-preset": "*",
    "@deepseek-ai/dsh-agent-preset-registry": "*",
    "@deepseek-ai/dsh-fs-local": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/dsh-mcp-manager": "*",
    "@deepseek-ai/dsh-ptc-runtime": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "*",
    "@deepseek-ai/dsh-subprocess-local": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tool-executor-native": "*",
    "@deepseek-ai/dsh-tool-executor-ptc": "*",
    "@deepseek-ai/dsh-tool-fs": "*",
    "@deepseek-ai/dsh-tool-fs-search": "*",
    "@deepseek-ai/dsh-tool-subagent": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-working-directory": "*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lornatang/dsh-plugin.git",
    "directory": "packages/workflow/dsh-caveman"
  },
  "homepage": "https://github.com/Lornatang/dsh-plugin/tree/main/packages/workflow/dsh-caveman#readme",
  "bugs": {
    "url": "https://github.com/Lornatang/dsh-plugin/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
