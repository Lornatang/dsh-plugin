{
  "name": "@lornatang/dsh-frontgate",
  "version": "0.1.15",
  "description": "Password protection and reverse proxy for the DeepSeek Harness Web UI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "pack:verify": "node scripts/verify-package.mjs",
    "test:dsh": "node scripts/verify-dsh.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "password",
    "auth",
    "login",
    "reverse-proxy",
    "websocket",
    "self-hosted"
  ],
  "license": "Apache-2.0",
  "author": "Lornatang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lornatang/dsh-plugin.git",
    "directory": "packages/access/dsh-frontgate"
  },
  "homepage": "https://github.com/Lornatang/dsh-plugin/tree/main/packages/access/dsh-frontgate#readme",
  "bugs": {
    "url": "https://github.com/Lornatang/dsh-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
